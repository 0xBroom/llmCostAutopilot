# Copy to `.env` and fill in. Every variable the service reads is listed here.
# `.env` is git-ignored; this file is committed and must stay complete.
#
# All settings are prefixed AUTOPILOT_ and are parsed into a single typed
# `Settings` object (src/autopilot/config/settings.py). There is no
# os.getenv() anywhere else in the codebase.

# --- Provider credentials ----------------------------------------------------
# Leave a provider blank to disable it. The model catalog will refuse to route
# to a model whose provider has no credentials configured.
AUTOPILOT_OPENAI_API_KEY=
AUTOPILOT_ANTHROPIC_API_KEY=

# Local models via Ollama. No key. Free at the point of use, which is exactly
# why tier 1 traffic goes here.
AUTOPILOT_OLLAMA_API_BASE=http://localhost:11434

# --- Storage -----------------------------------------------------------------
AUTOPILOT_DATABASE_URL=sqlite+aiosqlite:///./data/autopilot.db
AUTOPILOT_DATA_DIR=./data
AUTOPILOT_ARTIFACTS_DIR=./artifacts

# --- Configuration files -----------------------------------------------------
AUTOPILOT_MODEL_CATALOG_PATH=config/models.yaml
AUTOPILOT_ROUTING_POLICY_PATH=config/routing.yaml

# --- Routing and verification ------------------------------------------------
# Fraction of served requests sampled for async quality verification.
# Verifying everything costs more than never routing at all — see the
# sampling economics in the verification issue. This must stay well below 1.0.
AUTOPILOT_VERIFICATION_SAMPLE_RATE=0.15

# Confidence below this routes UP a tier. The system fails toward quality.
AUTOPILOT_LOW_CONFIDENCE_THRESHOLD=0.60

# Per-provider call timeout, seconds.
AUTOPILOT_REQUEST_TIMEOUT_S=30.0

# Wall-clock budget for a synchronous escalation retry, milliseconds.
AUTOPILOT_ESCALATION_LATENCY_BUDGET_MS=4000

# --- Observability -----------------------------------------------------------
# Storing raw prompt text is a privacy decision, not a default. Off.
AUTOPILOT_LOG_PROMPT_TEXT=false
AUTOPILOT_LOG_LEVEL=INFO
AUTOPILOT_LOG_JSON=true

# --- Determinism -------------------------------------------------------------
# Seeds the verification sampler so a replay produces the same sample.
AUTOPILOT_RANDOM_SEED=1337
