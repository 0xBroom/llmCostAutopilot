# Secrets — never commit. `.env.example` is the committed template.
.env
.env.*
!.env.example
*.pem
*.key

# Data and generated artifacts
data/
*.db
*.db-wal
*.db-shm
reports/

# Benchmark runs are transient and ignored, EXCEPT the one committed baseline
# reference run (#9) — it must live in the repo so the numbers are readable
# without credentials. Re-including a path needs its parent dirs re-included
# first, then the siblings re-ignored.
artifacts/*
!artifacts/baseline/
artifacts/baseline/*
!artifacts/baseline/2026-08-10/

# The taxonomy calibration run (#10) is committed for the same reason: the
# agreement number in docs/complexity-taxonomy.md must be re-derivable from
# the label passes in the repo, with no re-run and no credentials.
!artifacts/calibration/
artifacts/calibration/*
!artifacts/calibration/2026-08-20/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Tooling caches
.atl/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store
