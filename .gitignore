# Secrets — never commit. `.env.example` is the committed template.
.env
.env.*
!.env.example
*.pem
*.key

# Data and generated artifacts
data/
*.db
*.db-wal
*.db-shm
reports/

# Benchmark runs are transient and ignored, EXCEPT the one committed baseline
# reference run (#9) — it must live in the repo so the numbers are readable
# without credentials. Re-including a path needs its parent dirs re-included
# first, then the siblings re-ignored.
artifacts/*
!artifacts/baseline/
artifacts/baseline/*
!artifacts/baseline/2026-08-10/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store
